# Database and storage
DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dedicated Client Visit Cloudinary account. Do not reuse the CLOUDINARY_*
# account above. Uploads fail when these values are missing or when both
# cloud-name values are the same.
CLIENT_VISIT_CLOUDINARY_CLOUD_NAME=
CLIENT_VISIT_CLOUDINARY_API_KEY=
CLIENT_VISIT_CLOUDINARY_API_SECRET=
CLIENT_VISIT_CLOUDINARY_FOLDER=hrms-client-visits

# Firebase Admin service-account JSON on one line. Required for native push.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Google Meet API service account JSON with Workspace domain-wide delegation.
# Authorize scope: https://www.googleapis.com/auth/meetings.space.created
GOOGLE_MEET_SERVICE_ACCOUNT_JSON=
# Workspace user impersonated as the meeting organizer.
GOOGLE_MEET_ORGANIZER_EMAIL=

# Zoom Server-to-Server OAuth app with meeting:write:admin access.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=

# Microsoft Entra application with OnlineMeetings.ReadWrite.All and an
# application access policy granted to this Teams organizer user.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TEAMS_ORGANIZER_USER_ID=

# Transactional email (recommended)
RESEND_API_KEY=
# Must be a sender/domain verified in Resend. For initial testing only,
# use: BitByte HRMS <onboarding@resend.dev>
EMAIL_FROM=BitByte HRMS <onboarding@resend.dev>

# Optional legacy fallback when RESEND_API_KEY is not set
SENDGRID_API_KEY=
